{
  "extends": "../backend/tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "../api/dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@vercel/node": ["../node_modules/@vercel/node"]
    },
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/@vercel/node/types"
    ]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
