# Orbit Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# GitLab Configuration
# IMPORTANT: Use GitLab Personal Access Token with api scope
# Generate at: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# Your GitLab project ID (found in Project Settings > General)
# Or use the project path encoded: group%2Fproject-name
GITLAB_PROJECT_ID=your_project_id_here

# GitLab Agent name (for GitLab Agents feature)
GITLAB_AGENT=orbit-deploy-agent

# GitLab API URL (use self-hosted URL for self-hosted GitLab)
GITLAB_API_URL=https://gitlab.com/api/v4

# Flow Configuration
DEFAULT_FLOW=deploy-flow
MULTI_AGENT_FLOW=multi-agent-flow

# Logging
LOG_LEVEL=info
