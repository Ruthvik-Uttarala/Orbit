{
  "name": "orbit-devops",
  "version": "1.0.0",
  "description": "AI-native GitLab DevOps system with multi-agent orchestration",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:integration": "npm run test:integration:backend",
    "test:integration:backend": "cd backend && npm run test:integration",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "gitlab",
    "devops",
    "ci-cd",
    "agents",
    "automation",
    "orchestration"
  ],
  "author": "Orbit DevOps Team",
  "license": "MIT"
}
